# Server Configuration
PORT=5001
NODE_ENV=development
JWT_SECRET=orbit-super-secret-jwt-key-for-assessment-2026

# Database Configuration (MongoDB Atlas Cloud Cluster)
# For local dev: mongodb://127.0.0.1:27017/task_tracker
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/task_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/task_tracker?retryWrites=true&w=majority

# CORS (Comma-separated allowed frontend domains, e.g. on Netlify)
CORS_ORIGIN=http://localhost:5173,https://your-app-name.netlify.app

# Client Configuration (Vite)
# For local development: http://localhost:5001/api (or leave empty for Vite /api proxy)
# For Netlify production: https://your-backend-name.onrender.com/api
VITE_API_URL=http://localhost:5001/api
